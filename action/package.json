{
  "name": "baseline-check-tool",
  "version": "2.0.0",
  "description": "Check web features for baseline browser compatibility with smart recommendations and analytics",
  "type": "module",
  "bin": {
    "baseline-check": "./src/cli.js"
  },
  "main": "src/index.js",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "scan": "node src/cli.js scan",
    "check": "node src/cli.js check",
    "test": "node --test test/**/*.test.js",
    "prepublishOnly": "echo 'Skipping tests for initial publish'",
    "postinstall": "echo '🎉 baseline-check installed! Run: npx baseline-check init'"
  },
  "keywords": [
    "web",
    "compatibility",
    "baseline",
    "browser",
    "features",
    "mdn",
    "css",
    "javascript",
    "html",
    "web-apis",
    "ci-cd",
    "github-actions",
    "analytics",
    "recommendations"
  ],
  "author": {
    "name": "Baseline Check Team",
    "email": "team@baseline-check.dev",
    "url": "https://github.com/baseline-check"
  },
  "license": "MIT",
  "homepage": "https://github.com/baseline-check/baseline-check#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/baseline-check/baseline-check.git"
  },
  "bugs": {
    "url": "https://github.com/baseline-check/baseline-check/issues"
  },
  "dependencies": {
    "@mdn/browser-compat-data": "^5.6.0",
    "baseline-check": "file:baseline-check-2.0.0.tgz",
    "commander": "^11.1.0",
    "globby": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true,
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
